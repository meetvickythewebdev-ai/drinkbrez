        "review_summary": {
          "type": "review_summary",
          "settings": {
            "label": "Reviews",
            "reviews_anchor": "reviews"
          }
        },
        "intro": {
          "type": "product_intro",
          "settings": {}
        },
        "bundle_tiers": {
          "type": "bundle_tiers",
          "settings": {
            "title": "Bundle and",
            "title_emphasis": "Save",
            "badge": "Limited time",
            "animated_background": true,
            "tier_1_amount": "$50",
            "tier_1_reward": "Save $5",
            "tier_1_truck": false,
            "tier_2_amount": "$100",
            "tier_2_reward": "Save $10",
            "tier_2_truck": false,
            "tier_3_amount": "$125",
            "tier_3_reward": "Free",
            "tier_3_truck": true,
            "tier_4_amount": "$150",
            "tier_4_reward": "Save $15 +",
            "tier_4_truck": true,
            "tier_5_amount": "$200",
            "tier_5_reward": "Save $30 +",
            "tier_5_truck": true,
            "tier_6_amount": "$250",
            "tier_6_reward": "Save $50 +",
            "tier_6_truck": true,
            "note": "Applies to one-time and first subscription orders"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "subscription": {
          "type": "subscription",
          "settings": {
            "default_subscription": true,
            "subscription_label": "Subscribe &",
            "save_label": "Save",
            "onetime_label": "One Time Purchase",
            "unit_label": "can",
            "benefit_1": "Delivered monthly",
            "benefit_2_before": "Save",
            "benefit_2_after": "with each delivery",
            "benefit_3": "Pause, skip, or cancel anytime"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_price": true,
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": true
          }
        },
        "ingredients": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Full Ingredients",
            "content_metafield": "custom.ingredients",
            "icon": "none",
            "content": ""
          }
        },
        "warning": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- if product.tags contains 'THC' -%}<div class=\"product-warning\" data-geo-region=\"CA\"><p>⚠️ <strong>WARNING</strong>: Consuming this product during pregnancy exposes your child to delta-9 THC, which can affect your child's behavior and learning ability. For more information go to <a href=\"https://www.P65Warnings.ca.gov/cannabis\" target=\"_blank\" rel=\"noopener\">www.P65Warnings.ca.gov/cannabis</a>.</p></div>{%- endif -%}"
          }
        },
        "collection_scroller": {
          "type": "collection_scroller",
          "settings": {
            "title": "Explore Our Complete Collection",
            "collection": "pdp-complete-collection",
            "limit": 12
          }
        }
      },
      "block_order": [
        "title",
        "headline",
        "review_summary",
        "intro",
        "bundle_tiers",
        "variant_picker",
        "subscription",
        "buy_buttons",
        "ingredients",
        "warning",
        "collection_scroller"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_size": "small",
        "constrain_to_viewport": true,
        "media_fit": "cover",
        "gallery_layout": "thumbnail_slider",
        "mobile_thumbnails": "hide",
        "media_position": "left",
        "image_zoom": "none",
        "hide_variants": false,
        "enable_video_looping": false,
        "padding_top": 20,
        "padding_bottom": 0,
        "brand_styles": true,
        "gallery_arrows": true,
        "sticky_mobile_bar": true,
        "option_suffix": "",
        "hidden_option_values": "4",
        "purchase_style": "simple"
      }
