{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "review_summary": {
          "type": "review_summary",
          "settings": {
            "label": "Reviews",
            "reviews_anchor": "reviews"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "headline": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.custom.card_headline.value }}",
            "text_style": "uppercase"
          }
        },
        "icon_grid": {
          "type": "icon_grid",
          "settings": {
            "icon_1": "shopify://shop_images/pdp-icon-no-hangovers.svg",
            "text_1": "no hangovers & no regrets",
            "icon_2": "shopify://shop_images/pdp-icon-stackable.svg",
            "text_2": "Approachable & Stackable",
            "icon_3": "shopify://shop_images/pdp-icon-fast-acting.svg",
            "text_3": "fast acting & short lasting",
            "icon_4": "shopify://shop_images/pdp-icon-usa.svg",
            "text_4": "Hemp-Derived. Legal in Most States."
          }
        },
        "strength_selector": {
          "type": "strength_selector",
          "settings": {
            "title": "Strength"
          }
        },
        "bundle_tiers": {
          "type": "bundle_tiers",
          "settings": {
            "title": "Bundle and",
            "title_emphasis": "Save",
            "badge": "Limited time",
            "animated_background": true,
            "tier_1_amount": "$50",
            "tier_1_reward": "Save $5",
            "tier_1_truck": false,
            "tier_2_amount": "$100",
            "tier_2_reward": "Save $10",
            "tier_2_truck": false,
            "tier_3_amount": "$125",
            "tier_3_reward": "Free",
            "tier_3_truck": true,
            "tier_4_amount": "$150",
            "tier_4_reward": "Save $15 +",
            "tier_4_truck": true,
            "tier_5_amount": "$200",
            "tier_5_reward": "Save $30 +",
            "tier_5_truck": true,
            "tier_6_amount": "$250",
            "tier_6_reward": "Save $50 +",
            "tier_6_truck": true,
            "note": "Applies to one-time and first subscription orders"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "subscription": {
          "type": "subscription",
          "settings": {
            "default_subscription": true,
            "subscription_label": "Subscribe &",
            "save_label": "Save",
            "onetime_label": "One Time Purchase",
            "unit_label": "can",
            "benefit_1": "Delivered to your door every 1 month",
            "benefit_2_before": "Save",
            "benefit_2_after": "with each delivery",
            "benefit_3": "Pause, skip, or cancel anytime"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_price": true,
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": true
          }
        },
        "what_to_expect": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "What to expect",
            "content_metafield": "custom.what_to_expect",
            "icon": "none",
            "content": ""
          }
        },
        "ingredients": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Full Ingredients",
            "content_metafield": "custom.ingredients",
            "icon": "none",
            "content": ""
          }
        },
        "warning": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- if product.tags contains 'THC' -%}<div class=\"product-warning\" data-geo-region=\"CA\"><p>⚠️ <strong>WARNING</strong>: Consuming this product during pregnancy exposes your child to delta-9 THC, which can affect your child's behavior and learning ability. For more information go to <a href=\"https://www.P65Warnings.ca.gov/cannabis\" target=\"_blank\" rel=\"noopener\">www.P65Warnings.ca.gov/cannabis</a>.</p></div>{%- endif -%}"
          }
        },
        "collection_scroller": {
          "type": "collection_scroller",
          "settings": {
            "title": "Explore Our Complete Collection",
            "collection": "pdp-complete-collection",
            "limit": 12
          }
        }
      },
      "block_order": [
        "review_summary",
        "title",
        "headline",
        "icon_grid",
        "strength_selector",
        "bundle_tiers",
        "variant_picker",
        "subscription",
        "buy_buttons",
        "what_to_expect",
        "ingredients",
        "warning",
        "collection_scroller"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_size": "small",
        "constrain_to_viewport": true,
        "media_fit": "cover",
        "gallery_layout": "thumbnail_slider",
        "mobile_thumbnails": "hide",
        "media_position": "left",
        "image_zoom": "none",
        "hide_variants": false,
        "enable_video_looping": false,
        "padding_top": 20,
        "padding_bottom": 0,
        "brand_styles": true,
        "gallery_arrows": true,
        "sticky_mobile_bar": true,
        "option_suffix": "pack",
        "hidden_option_values": "4"
      }
    },
    "faq": {
      "type": "home-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "How is this legal?",
            "answer": "<p>In 2018, Congress passed the Farm Bill, making a form of cannabis known as hemp federally legal. We extract our THC from hemp, which allows us to be legally sold in most states to adults 21+.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "What does it feel like?",
            "answer": "<p>Most feel a quick, uplifting euphoria followed by a wave of relief and relaxation—perfect for socializing, without losing control, hangovers, or next-day regret. Unlike traditional edibles, our fast-acting micronized extracts kick in within 5 minutes and fade gently after about 1.5 hours.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Is it like an edible?",
            "answer": "<p>No—In fact, we call it the antidote to the bad edible experience. Thanks to our nano-emulsification process, the THC effect is lighter, clearer, faster-acting, shorter-lasting, social, and predictable—more like your favorite adult beverage than a traditional edible, with adverse reactions being very rare.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Will I get anxious or paranoid?",
            "answer": "<p>Highly unlikely. Thanks to our soothing ingredients, microdosed approach, and our rapid-absorption nano-emulsification process, adverse reactions are very rare.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "What does microdosed mean?",
            "answer": "<p>We use just the right amount in each can to help you feel elevated and happy without overwhelming. This also means you have full control over how many you decide to consume, creating the experience perfect for you.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "Where do you ship?",
            "answer": "<p>We ship our THC-free blends to all 50 states and most major countries. Our THC-infused blends are available in most U.S. states for adults 21 and over.</p>"
          }
        }
      },
      "block_order": [
        "question_1",
        "question_2",
        "question_3",
        "question_4",
        "question_5",
        "question_6"
      ],
      "settings": {
        "heading": "Frequently asked questions",
        "background_image": "shopify://shop_images/pdp-faq-background.jpg",
        "margin_top": 40,
        "margin_bottom": 28,
        "margin_bottom_mobile": 60
      }
    },
