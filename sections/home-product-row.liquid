{{ 'section-home-product-row.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #ProductRow-{{ section.id }} {
    --row-margin-top-desktop: {{ section.settings.margin_top_desktop }}px;
    --row-margin-bottom-desktop: {{ section.settings.margin_bottom_desktop }}px;
    --row-margin-top-mobile: {{ section.settings.margin_top_mobile }}px;
    --row-margin-bottom-mobile: {{ section.settings.margin_bottom_mobile }}px;
    --row-icon-width-desktop: {{ section.settings.icon_width_desktop }}px;
    --row-icon-width-mobile: {{ section.settings.icon_width_mobile }}px;
  }
{%- endstyle -%}

