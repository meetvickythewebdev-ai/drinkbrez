  <svg width="45" height="45" viewBox="0 0 29 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect width="28.4266" height="27.2475" rx="13.6238" fill="white" fill-opacity="0.3"/>
    <path d="M13.9131 16.6842C12.1671 12.713 11.8253 7.43038 14.084 4C16.0097 6.66839 16.0519 11.3776 15.5565 13.7262" stroke="#231F20" stroke-width="0.5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M13.9503 17.1133C13.6977 18.2543 11.5727 20.6844 9.41797 20.7659C9.61718 19.9298 10.3075 19.0734 10.799 18.5472" stroke="#231F20" stroke-width="0.5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M9.4609 15.8086C8.49622 15.8596 7.18768 16.1131 6.00781 17.1151C7.62239 18.039 9.35565 18.4397 12.5649 17.4262" stroke="#231F20" stroke-width="0.5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M13.2295 16.906C11.9292 16.6615 7.15167 14.3054 6 9.97852C9.0175 10.4945 11.1933 12.7707 12.289 14.1233" stroke="#231F20" stroke-width="0.5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M15.0117 15.5431C16.9435 12.8833 20.1311 10.2679 22.3527 9.98633C20.2837 14.302 18.3571 15.9127 16.0075 16.7072" stroke="#231F20" stroke-width="0.5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M15.3086 17.1133C17.6268 18.2765 20.5171 18.0172 22.4266 16.9799C21.9053 16.4601 20.4524 15.9554 19.1044 15.8242" stroke="#231F20" stroke-width="0.5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M14.457 17.1133C15.148 18.6173 16.8421 20.1436 19.2569 20.7659C19.0547 20.1219 18.5145 19.3123 17.7169 18.4775" stroke="#231F20" stroke-width="0.5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M14.2927 17.1133C13.8394 18.9359 14.6345 20.5955 15.3849 21.2475" stroke="#231F20" stroke-width="0.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
{%- endcapture -%}

{%- capture star_icon -%}
  <svg width="45" height="45" viewBox="0 0 42 42" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect width="42" height="42" rx="21" fill="white" fill-opacity="0.3"/>
    <path d="M23.5479 17.5381C23.6869 17.9235 24.0465 18.1851 24.4561 18.1982L31.9619 18.4385L26.0303 23.0439C25.7471 23.2639 25.6066 23.6157 25.6523 23.9639L25.6836 24.1123L27.7744 31.3252L21.5615 27.1074C21.2225 26.8772 20.7775 26.8773 20.4385 27.1074L14.2256 31.3252L16.3164 24.1123C16.4305 23.7188 16.2933 23.2953 15.9697 23.0439L10.0381 18.4385L17.5439 18.1982C17.9535 18.1851 18.3131 17.9236 18.4521 17.5381L21 10.4736L23.5479 17.5381Z" stroke="black"/>
  </svg>
{%- endcapture -%}

<div id="ProductRow-{{ section.id }}" class="product-row brand-section page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="product-row__heading{% if section.settings.large_cards %} product-row__heading--large{% endif %}">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
  <div class="product-row__layout{% if section.settings.title == blank %} product-row__layout--no-title{% endif %}">
    {%- if section.settings.title != blank -%}
    <div class="product-row__intro">
      <div class="product-row__glow" aria-hidden="true">
        {%- if section.settings.glow_image != blank -%}
          {{ section.settings.glow_image | image_url: width: 1200 | image_tag: class: 'product-row__glow-image product-row__glow-image--desktop', loading: 'lazy', alt: '' }}
        {%- endif -%}
        {%- if section.settings.glow_image_mobile != blank -%}
          {{ section.settings.glow_image_mobile | image_url: width: 1200 | image_tag: class: 'product-row__glow-image product-row__glow-image--mobile', loading: 'lazy', alt: '' }}
        {%- endif -%}
      </div>
      <h3 class="product-row__title">
        {%- if section.settings.icon != blank -%}
          {{ section.settings.icon | image_url: width: 120 | image_tag: class: 'product-row__icon', alt: '' }}
        {%- endif -%}
        <span>{{ section.settings.title | escape }}</span>
      </h3>
      {%- if section.settings.subtitle != blank -%}
        <div class="product-row__subtitle">{{ section.settings.subtitle | escape }}</div>
      {%- endif -%}
    </div>
    {%- endif -%}

    <div class="product-row__grid product-row__grid--{{ section.settings.columns_desktop }}{% if section.settings.large_cards %} product-row__grid--large{% endif %}">
      {%- for block in section.blocks -%}
        <div class="product-row__item product-row__item--{{ block.settings.visibility }}" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '#' }}" class="product-row__link">
            {%- if block.settings.badge != blank -%}
              <div
                class="product-row__badge"
                style="--badge-color: {{ block.settings.badge_text_color }}; --badge-background: {{ block.settings.badge_background }};"
              >
                {{ block.settings.badge | escape }}
              </div>
            {%- endif -%}
            <div class="product-row__media">
              {%- if block.settings.show_leaf -%}
                <div class="product-row__floating-icon">{{ leaf_icon }}</div>
              {%- endif -%}
              {%- if block.settings.show_star -%}
                <div class="product-row__floating-icon product-row__floating-icon--end">{{ star_icon }}</div>
              {%- endif -%}
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    widths: '400, 600, 800',
                    sizes: '(min-width: 990px) 350px, 50vw',
                    loading: 'lazy',
                    alt: block.settings.title
                }}
              {%- endif -%}
              {%- liquid
                assign has_strengths = false
                if block.settings.strength_1_label != blank or block.settings.strength_2_label != blank or block.settings.strength_3_label != blank
                  assign has_strengths = true
                endif
              -%}
              {%- if has_strengths -%}
                <div class="product-row__strengths">
                  {%- for i in (1..3) -%}
                    {%- liquid
                      assign label_key = 'strength_' | append: i | append: '_label'
                      assign link_key = 'strength_' | append: i | append: '_link'
                    -%}
                    {%- if block.settings[label_key] != blank -%}
                      <span
                        class="product-row__strength"
                        role="link"
                        tabindex="0"
                        data-href="{{ block.settings[link_key] }}"
                      >
                        {{- block.settings[label_key] | escape -}}
                      </span>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
            <div class="product-row__product-title">
              <span>
                {{- block.settings.title | escape }}
                <svg width="9" height="18" viewBox="0 0 9 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M0.146447 0.646447C0.341709 0.451184 0.658291 0.451184 0.853553 0.646447L8.85355 8.64645C9.04882 8.84171 9.04882 9.15829 8.85355 9.35355L0.853553 17.3536C0.658291 17.5488 0.341709 17.5488 0.146447 17.3536C-0.0488155 17.1583 -0.0488155 16.8417 0.146447 16.6464L7.79289 9L0.146447 1.35355C-0.0488155 1.15829 -0.0488155 0.841709 0.146447 0.646447Z" fill="black"/>
                </svg>
              </span>
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}
</div>

<script>
  (() => {
    const row = document.getElementById('ProductRow-{{ section.id }}');
    if (!row || row.dataset.ready) return;
    row.dataset.ready = 'true';
    const go = (event) => {
      const pill = event.target.closest('.product-row__strength');
      if (!pill || !pill.dataset.href) return;
      if (event.type === 'keydown' && event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      event.stopPropagation();
      window.location.href = pill.dataset.href;
    };
    row.addEventListener('click', go);
    row.addEventListener('keydown', go);
  })();
</script>

{% schema %}
{
  "name": "Product row",
  "class": "product-row-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading above the row"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Cards per row on desktop",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "3"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Category icon",
      "info": "Leave the category title blank to show the cards without the category column."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Category title",
      "default": "Category"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Category description"
    },
    {
      "type": "image_picker",
      "id": "glow_image",
      "label": "Glow image"
    },
    {
      "type": "image_picker",
      "id": "glow_image_mobile",
      "label": "Glow image on mobile"
    },
    {
      "type": "range",
      "id": "icon_width_desktop",
      "label": "Icon width on desktop",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 46
    },
    {
      "type": "range",
      "id": "icon_width_mobile",
      "label": "Icon width on mobile",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "large_cards",
      "label": "Use large heading and cards",
      "default": false
    },
    {
      "type": "range",
      "id": "margin_top_desktop",
      "label": "Top margin on desktop",
      "min": -80,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_bottom_desktop",
      "label": "Bottom margin on desktop",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Top margin on mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "label": "Bottom margin on mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Product"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "visibility",
          "label": "Show on",
          "options": [
            {
              "value": "all",
              "label": "All screens"
            },
            {
              "value": "desktop",
              "label": "Desktop and tablet only"
            },
            {
              "value": "mobile",
              "label": "Mobile only"
            }
          ],
          "default": "all"
        },
        {
          "type": "checkbox",
          "id": "show_leaf",
          "label": "Show THC icon",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_star",
          "label": "Show star icon",
          "default": false
        },
        {
          "type": "header",
          "content": "Badge"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge text"
        },
        {
          "type": "color",
          "id": "badge_background",
          "label": "Badge background",
          "default": "#ff4f8b"
        },
        {
          "type": "color",
          "id": "badge_text_color",
          "label": "Badge text",
          "default": "#ffffff"
        },
        {
          "type": "header",
          "content": "Strength links"
        },
        {
          "type": "text",
          "id": "strength_1_label",
          "label": "Strength 1 label"
        },
        {
          "type": "url",
          "id": "strength_1_link",
          "label": "Strength 1 link"
        },
        {
          "type": "text",
          "id": "strength_2_label",
          "label": "Strength 2 label"
        },
        {
          "type": "url",
          "id": "strength_2_link",
          "label": "Strength 2 link"
        },
        {
          "type": "text",
          "id": "strength_3_label",
          "label": "Strength 3 label"
        },
        {
          "type": "url",
          "id": "strength_3_link",
          "label": "Strength 3 link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product row"
    }
  ]
}
{% endschema %}
