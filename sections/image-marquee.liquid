{{ 'section-image-marquee.css' | asset_url | stylesheet_tag }}
<script src="{{ 'image-marquee.js' | asset_url }}" defer="defer"></script>

<image-marquee
  class="image-marquee"
  data-speed="{{ section.settings.speed }}"
  role="region"
  aria-roledescription="carousel"
  {% if section.settings.heading != blank %}
    aria-label="{{ section.settings.heading | escape }}"
  {% endif %}
>
  <div class="image-marquee__viewport" data-marquee-viewport>
    <ul class="image-marquee__track list-unstyled" role="list" data-marquee-track>
      {%- for block in section.blocks -%}
        <li class="image-marquee__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag: widths: '400, 600, 800', sizes: '(min-width: 750px) 27vw, 50vw', loading: 'lazy', draggable: 'false'
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</image-marquee>

{% schema %}
{
  "name": "Image marquee",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Accessible label",
      "info": "Read by screen readers only."
    },
    {
      "type": "range",
      "id": "speed",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Scroll speed per second",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image marquee",
      "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }]
    }
  ]
}
{% endschema %}
