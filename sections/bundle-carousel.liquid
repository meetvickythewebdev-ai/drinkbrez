{{ 'section-bundle-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bundle-carousel.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #BundleCarousel-{{ section.id }} {
    --carousel-max-width: {{ section.settings.max_width }}px;
  }
{%- endstyle -%}

<bundle-carousel
  id="BundleCarousel-{{ section.id }}"
  class="bundle-carousel bundle-carousel--{{ section.settings.layout }}{% if section.settings.full_width %} bundle-carousel--full{% endif %}{% if section.settings.hide_mobile %} small-hide{% endif %}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-delay="{{ section.settings.autoplay_delay | times: 1000 }}"
  data-speed="{{ section.settings.speed }}"
  role="region"
  aria-roledescription="carousel"
  {% if section.settings.heading != blank %}
    aria-label="{{ section.settings.heading | escape }}"
  {% endif %}
>
  <div class="bundle-carousel__inner">
    <div class="bundle-carousel__viewport" data-carousel-viewport>
      <ul class="bundle-carousel__track" role="list" data-carousel-track>
        {%- for block in section.blocks -%}
          <li
            class="bundle-carousel__slide"
            role="group"
            aria-roledescription="slide"
            aria-label="{{ forloop.index }} / {{ forloop.length }}"
            data-carousel-slide
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="bundle-carousel__link">
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 860
                | image_tag:
                  loading: 'lazy',
                  widths: '360, 430, 720, 860',
                  sizes: '(min-width: 1025px) 330px, (min-width: 768px) 33vw, 100vw',
                  class: 'bundle-carousel__image',
                  draggable: 'false'
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'bundle-carousel__image placeholder-svg' }}
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</bundle-carousel>

{% schema %}
{
  "name": "Bundle image carousel",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "bundle",
          "label": "Four across, overlapping the next section"
        },
        {
          "value": "wide",
          "label": "Three across, full width"
        },
        {
          "value": "compact",
          "label": "Four across, no overlap"
        }
      ],
      "default": "bundle"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "info": "Runs the strip edge to edge. Slides keep their size, so wider screens show more of them.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Accessible label",
      "info": "Read by screen readers only."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 0.5,
      "max": 10,
      "step": 0.1,
      "unit": "s",
      "label": "Time between slides",
      "default": 3
    },
    {
      "type": "range",
      "id": "speed",
      "min": 200,
      "max": 4000,
      "step": 100,
      "unit": "ms",
      "label": "Slide speed",
      "default": 1600
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1900,
      "step": 20,
      "unit": "px",
      "label": "Maximum width",
      "default": 1440
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "430 x 512px PNG with rounded corners recommended."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle image carousel",
      "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }]
    }
  ]
}
{% endschema %}
