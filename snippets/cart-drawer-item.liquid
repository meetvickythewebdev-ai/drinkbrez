{% doc %}
  Renders one cart drawer line: image, title, variant, discounts, quantity stepper, remove button and
  price, followed by the subscription switch when the product sells on a subscription.

  @param {line_item} item - The cart line to render.

  @example
  {% render 'cart-drawer-item', item: item %}
{% enddoc %}

{%- liquid
  assign line = item.index | plus: 1
  assign upgrade_plan = null
  assign upgrade_percent = 0
  if settings.cart_subscription_switch and item.product.selling_plan_groups.size > 0
    assign upgrade_allocation = item.variant.selling_plan_allocations | first
    if upgrade_allocation and item.variant.price > 0
      assign upgrade_plan = upgrade_allocation.selling_plan
      assign upgrade_percent = item.variant.price | minus: upgrade_allocation.price | times: 100 | divided_by: item.variant.price | round
    endif
  endif
-%}

<li
  id="CartDrawer-Item-{{ line }}"
  class="cart-item cart-drawer-item{% if item.parent_relationship.parent != null %} cart-drawer-item--nested{% endif %}"
  {% if item.parent_relationship.parent != null %}
    aria-label="{{- 'products.product.nested_label' | t: title: item.product.title, parent_title: item.parent_relationship.parent.title | escape -}}"
  {% endif %}
>
  <div class="cart-drawer-item__row">
    <a href="{{ item.url }}" class="cart-drawer-item__media" tabindex="-1" aria-hidden="true">
      {%- if item.image -%}
        <img
          src="{{ item.image | image_url: width: 180 }}"
          alt=""
          loading="lazy"
          width="90"
          height="90"
        >
      {%- endif -%}
    </a>

    <div class="cart-drawer-item__info">
      <a href="{{ item.url }}" class="cart-drawer-item__title cart-item__name">{{ item.product.title | escape }}</a>

      {%- unless item.instructions and item.instructions.can_remove == false -%}
        <cart-remove-button id="CartDrawer-Remove-{{ line }}" class="cart-drawer-item__remove" data-index="{{ line }}">
          <button
            type="button"
            aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
            data-variant-id="{{ item.variant.id }}"
          >
            {{- 'icon-cart-remove.svg' | inline_asset_content -}}
          </button>
        </cart-remove-button>
      {%- endunless -%}

      {%- unless item.product.has_only_default_variant -%}
        <p class="cart-drawer-item__variant">{{ item.variant.title | escape }}</p>
      {%- endunless -%}

      {%- for property in item.properties -%}
        {%- assign property_first_char = property.first | slice: 0 -%}
        {%- if property.last != blank and property_first_char != '_' -%}
          <p class="cart-drawer-item__property">{{ property.first }}: {{ property.last }}</p>
        {%- endif -%}
      {%- endfor -%}

      {%- for discount in item.line_level_discount_allocations -%}
        <p class="cart-drawer-item__discount">{{ discount.discount_application.title | escape }}</p>
      {%- endfor -%}

      <div class="cart-drawer-item__quantity">
        <quantity-input class="cart-drawer-item__stepper">
          <button
            class="quantity__button"
            name="minus"
            type="button"
            {% if item.instructions and item.instructions.can_update_quantity == false %}
              disabled
            {% endif %}
          >
            <span class="visually-hidden">
              {{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}
            </span>
            {{- 'icon-cart-minus.svg' | inline_asset_content -}}
          </button>
          <input
            class="quantity__input"
            type="number"
            data-quantity-variant-id="{{ item.variant.id }}"
            data-quantity-line-key="{{ item.key }}"
            name="updates[]"
            value="{{ item.quantity }}"
            data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
            min="0"
            data-min="{{ item.variant.quantity_rule.min }}"
            {% if item.variant.quantity_rule.max != null %}
              max="{{ item.variant.quantity_rule.max }}"
            {% endif %}
            step="{{ item.variant.quantity_rule.increment }}"
            aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
            id="Drawer-quantity-{{ line }}"
            data-index="{{ line }}"
            {% if item.instructions and item.instructions.can_update_quantity == false %}
              disabled
            {% endif %}
          >
          <button
            class="quantity__button"
            name="plus"
            type="button"
            {% if item.instructions and item.instructions.can_update_quantity == false %}
              disabled
            {% endif %}
          >
            <span class="visually-hidden">
              {{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}
            </span>
            {{- 'icon-cart-plus.svg' | inline_asset_content -}}
          </button>
        </quantity-input>
      </div>

      <div class="cart-drawer-item__price">
        {%- render 'loading-spinner' -%}
        {%- assign full_line_price = item.variant.price | times: item.quantity -%}
        {%- if item.final_line_price < full_line_price -%}
          <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
          <s class="cart-drawer-item__compare">{{ full_line_price | money }}</s>
          <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
          <span class="cart-drawer-item__sale">{{ item.final_line_price | money }}</span>
        {%- else -%}
          <span class="cart-drawer-item__amount">{{ item.final_line_price | money }}</span>
        {%- endif -%}
      </div>

      <div id="CartDrawer-LineItemError-{{ line }}" class="cart-item__error cart-drawer-item__error" role="alert">
        <small class="cart-item__error-text"></small>
      </div>
    </div>
  </div>

  {%- if settings.cart_subscription_switch and item.product.selling_plan_groups.size > 0 -%}
    <div class="cart-drawer-item__subscription">
      {%- if item.selling_plan_allocation -%}
        {%- assign group = item.product.selling_plan_groups | first -%}
        <label class="visually-hidden" for="CartDrawer-Plan-{{ line }}">{{ group.name | escape }}</label>
        <select
          id="CartDrawer-Plan-{{ line }}"
          class="cart-drawer-item__plan"
          data-line="{{ line }}"
          data-quantity="{{ item.quantity }}"
          data-plan-select
        >
          {%- unless item.product.requires_selling_plan -%}
            <optgroup label="Pay Full Price">
              <option value="">One-time only</option>
            </optgroup>
          {%- endunless -%}
          <optgroup label="Subscribe and Save {{ upgrade_percent }}%">
            {%- for allocation in item.variant.selling_plan_allocations -%}
              <option
                value="{{ allocation.selling_plan.id }}"
                {% if allocation.selling_plan.id == item.selling_plan_allocation.selling_plan.id %}
                  selected
                {% endif %}
              >
                {{ allocation.selling_plan.name | escape }}
              </option>
            {%- endfor -%}
          </optgroup>
        </select>
      {%- elsif upgrade_plan -%}
        <button
          type="button"
          class="cart-drawer-item__upgrade"
          data-line="{{ line }}"
          data-quantity="{{ item.quantity }}"
          data-selling-plan="{{ upgrade_plan.id }}"
          data-upgrade
        >
          {{- settings.cart_subscription_upgrade_label | replace: '[percent]', upgrade_percent | escape -}}
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}
</li>
