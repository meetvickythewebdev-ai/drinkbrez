{% doc %}
  Outputs `<source>` tags for a Shopify video, preferring MP4 renditions up to 1080p.

  @param {object} video - A video file from a `video` setting.

  @example
  <video muted loop playsinline>{% render 'video-sources', video: section.settings.video %}</video>
{% enddoc %}

{%- liquid
  assign best = null
  for source in video.sources
    if source.format == 'mp4' and source.height <= 1080
      if best == null or source.height > best.height
        assign best = source
      endif
    endif
  endfor
-%}
{%- if best -%}
  <source src="{{ best.url }}" type="{{ best.mime_type }}">
{%- endif -%}
{%- for source in video.sources -%}
  {%- if source.format == 'm3u8' -%}
    <source src="{{ source.url }}" type="{{ source.mime_type }}">
  {%- endif -%}
{%- endfor -%}
