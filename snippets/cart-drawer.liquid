{% doc %}
  Renders the cart drawer: a floating panel with a rewards bar, line items that can switch to and from a
  subscription, product recommendations, and a checkout footer. Keeps Dawn's ids and elements so
  cart.js and cart-drawer.js can update quantities and re-render the drawer.

  @param {block} [block] - An optional current block whose theme-editor attributes are applied to footer regions.

  @example
  {% render 'cart-drawer' %}
{% enddoc %}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-drawer-brand.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer {
    visibility: hidden;
  }
</style>

<cart-drawer class="drawer cart-drawer-brand{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      <div class="cart-drawer__header">
        <div class="cart-drawer__title-bar">
          <h2 class="cart-drawer__title">{{ 'sections.cart.title' | t }}</h2>
          <div class="cart-drawer__title-actions">
            {%- if settings.cart_show_login and shop.customer_accounts_enabled and customer == null -%}
              <a href="{{ routes.account_login_url }}" class="cart-drawer__login">Login</a>
            {%- endif -%}
          </div>
          <button
            class="drawer__close cart-drawer__close"
            type="button"
            onclick="this.closest('cart-drawer').close()"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {{- 'icon-cart-close.svg' | inline_asset_content -}}
          </button>
        </div>
        <div class="cart-drawer__progress">
          {%- render 'cart-drawer-rewards' -%}
        </div>
      </div>

      <cart-drawer-items
        class="cart-drawer__body{% if cart == empty %} is-empty{% endif %}"
        view-event-payload="{{ cart | standard_event_data: 'view', context: 'dialog' | escape }}"
        view-event-trigger="manual"
      >
        {%- if cart == empty -%}
          <div class="drawer__inner-empty cart-drawer__empty">
            {%- if settings.cart_empty_text != blank -%}
              <div class="cart-drawer__empty-text">{{ settings.cart_empty_text }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <form action="{{ routes.cart_url }}" id="CartDrawer-Form" class="cart__contents cart-drawer__form" method="post">
          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {%- if cart != empty -%}
              <ul class="cart-drawer__items" role="list">
                {%- for item in cart.items -%}
                  {%- render 'cart-drawer-item', item: item -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
            <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
            <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
              {{ 'accessibility.loading' | t }}
            </p>
          </div>
          <div id="CartDrawer-CartErrors" class="cart-drawer__errors" role="alert"></div>
        </form>

        {%- render 'cart-drawer-upsells' -%}
      </cart-drawer-items>

      <div class="drawer__footer">
        {%- if settings.show_cart_note -%}
          <details id="Details-CartDrawer" class="cart-drawer__note">
            <summary>
              <span class="summary__title">
                {{ 'sections.cart.note' | t }}
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </summary>
            <cart-note class="cart__note field">
              <label class="visually-hidden" for="CartDrawer-Note">{{ 'sections.cart.note' | t }}</label>
              <textarea
                id="CartDrawer-Note"
                class="text-area text-area--resize-vertical field__input"
                name="note"
                placeholder="{{ 'sections.cart.note' | t }}"
              >{{ cart.note }}</textarea>
            </cart-note>
          </details>
        {%- endif -%}

        <div class="cart-drawer__footer" {{ block.shopify_attributes }}>
          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul class="cart-drawer__order-discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
              {%- for discount in cart.cart_level_discount_applications -%}
                <li>
                  <span>{{ discount.title | escape }}</span>
                  <span>-{{ discount.total_allocated_amount | money }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if cart != empty -%}
            <div class="cart-drawer__subtotal" role="status">
            <span>
              {{- 'customer.order.subtotal' | t }} ({{ cart.item_count }}
              {{ cart.item_count | pluralize: 'item', 'items' -}}
              )
            </span>
            <span class="visually-hidden">{{ 'sections.cart.estimated_total' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          {%- endif -%}

          {%- if settings.cart_legal_text != blank -%}
            <p class="cart-drawer__legal">{{ settings.cart_legal_text }}</p>
          {%- endif -%}

          {%- if cart != empty -%}
          <button
            type="submit"
            id="CartDrawer-Checkout"
            class="cart-drawer__checkout"
            name="checkout"
            form="CartDrawer-Form"
          >
            {{ settings.cart_checkout_label | default: 'Checkout' | escape }} | {{ cart.total_price | money }}
          </button>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</cart-drawer>
